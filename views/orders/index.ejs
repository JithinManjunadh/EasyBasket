<%- layout("layouts/boilerplate") %>

<style>
    .orders-wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 40px 0 64px;
    }
    .orders-heading {
        font-family: 'Fraunces', serif;
        font-size: 30px;
        font-weight: 300;
        letter-spacing: -0.5px;
        color: var(--ink);
        margin-bottom: 32px;
    }
    .order-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-bottom: 20px;
    }
    .order-card-header {
        background: var(--cream-2);
        padding: 14px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        border-bottom: 1px solid var(--border);
    }
    .order-meta-item {
        font-size: 12.5px;
        color: var(--ink-3);
    }
    .order-meta-item strong {
        color: var(--ink-2);
        font-weight: 500;
    }
    .order-items-list {
        padding: 0 24px;
    }
    .order-item {
        display: grid;
        grid-template-columns: 58px 1fr auto auto;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
    }
    .order-item:last-child { border-bottom: none; }
    .order-item-img {
        width: 58px;
        height: 58px;
        border-radius: 6px;
        object-fit: cover;
        background: var(--cream-2);
        display: block;
    }
    .order-item-name {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
    }
    .order-item-qty {
        font-size: 12px;
        color: var(--ink-3);
        margin-top: 3px;
    }
    .order-item-subtotal {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        white-space: nowrap;
    }
    .order-card-footer {
        padding: 14px 24px;
        background: var(--cream);
        border-top: 1px solid var(--border);
        text-align: right;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink);
    }
    .orders-empty-state {
        text-align: center;
        padding: 80px 0;
        color: var(--ink-3);
    }
    .orders-empty-state i {
        font-size: 48px;
        margin-bottom: 16px;
        display: block;
        color: var(--cream-3);
    }
    .orders-empty-state p { font-size: 15px; }

    @media (max-width: 560px) {
        .order-item { grid-template-columns: 48px 1fr auto; }
        .order-item-subtotal { display: none; }
        .order-card-header { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="orders-wrap">
    <h2 class="orders-heading">Your Order History</h2>

    <% if (orders.length === 0) { %>
        <div class="orders-empty-state">
            <i class="fa fa-box-open"></i>
            <p class="empty-orders">You have no orders yet.</p>
        </div>
    <% } %>

    <% orders.forEach(order => { %>
        <div class="order-card">
            <div class="order-card-header">
                <span class="order-meta-item"><strong>Order Placed:</strong> <%= order.createdAt.toDateString() %></span>
                <span class="order-meta-item"><strong>Payment Method:</strong> <%= order.paymentMethod %></span>
            </div>

            <div class="order-items-list">
                <% order.items.forEach(item => { %>
                    <div class="order-item">
                        <img class="order-item-img" src="<%= item.product.image.url %>" alt="<%= item.product.title %>">
                        <div>
                            <div class="order-item-name"><%= item.product.title %></div>
                            <div class="order-item-qty">Qty: <%= item.quantity %> × $<%= item.product.price %></div>
                        </div>
                        <div class="order-item-subtotal">$<%= item.quantity * item.product.price %></div>
                    </div>
                <% }) %>
            </div>

            <div class="order-card-footer">
                Total: $<%= order.items.reduce((sum, i) => sum + (i.quantity * i.product.price), 0) %>
            </div>
        </div>
    <% }) %>
</div>
