<%- layout("layouts/boilerplate") %>
<link rel="stylesheet" href="/css/cart.css">

<div class="cart-page">

  <div class="cart-page-header">
    <h1 class="cart-page-title">Your Cart</h1>
    <% if (cart.items.length > 0) { %>
      <span class="cart-item-tag">
        <span id="cart-item-count"><%= cart.items.length %></span>
        item<%= cart.items.length > 1 ? 's' : '' %>
      </span>
    <% } %>
  </div>

  <% if (cart.items.length > 0) { %>

    <div class="cart-layout">

      <!-- Items Column -->
      <div class="cart-items-col">
        <div class="cart-items-card">
          <% cart.items.forEach(item => { %>
            <div class="cart-item" id="cart-item-<%= item.product._id %>">

              <div class="cart-product-image">
                <img
                  src="<%= item.product.image.url %>"
                  alt="<%= item.product.name %>"
                  loading="lazy"
                >
              </div>

              <div class="cart-product-details">
                <h4><%= item.product.name %></h4>
                <p class="brand"><%= item.product.brand || '' %></p>
                <p class="description"><%= item.product.description || '' %></p>
              </div>

              <!-- Quantity Controls -->
              <div class="cart-product-quantity">
                <div class="qty-controls">
                  <button
                    class="qty-btn qty-decrement"
                    data-product-id="<%= item.product._id %>"
                    aria-label="Decrease quantity"
                  >
                    <i class="fa-solid fa-minus"></i>
                  </button>
                  <span class="qty-value" id="qty-<%= item.product._id %>"><%= item.quantity %></span>
                  <button
                    class="qty-btn qty-increment"
                    data-product-id="<%= item.product._id %>"
                    aria-label="Increase quantity"
                  >
                    <i class="fa-solid fa-plus"></i>
                  </button>
                </div>
              </div>

              <!-- Item Total Price -->
              <div class="cart-product-price" id="item-price-<%= item.product._id %>">
                $<%= (item.product.price * item.quantity).toFixed(2) %>
              </div>

              <!-- Full Remove Button -->
              <div class="cart-product-remove">
                <button
                  class="remove-btn"
                  data-product-id="<%= item.product._id %>"
                  aria-label="Remove item"
                  title="Remove from cart"
                >
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>

            </div>
          <% }) %>
        </div>

        <div class="cart-continue">
          <a href="/products" class="btn-lumeo-outline">
            <i class="fa-solid fa-arrow-left"></i>
            Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary Column -->
      <div class="cart-summary-col">
        <div class="cart-summary-card">

          <h2 class="summary-heading">Order Summary</h2>

          <div class="summary-lines">
            <div class="summary-line">
              <span>Subtotal</span>
              <span>$<span id="cart-total-price"><%= cart.items.reduce((sum, item) => sum + item.quantity * item.product.price, 0).toFixed(2) %></span></span>
            </div>
            <div class="summary-line">
              <span>Shipping</span>
              <span class="summary-free">Free</span>
            </div>
            <div class="summary-line summary-line-tax">
              <span>Tax</span>
              <span>Calculated at checkout</span>
            </div>
          </div>

          <div class="summary-total-row">
            <span>Total</span>
            <span class="summary-total-amount">
              $<span id="cart-grand-total"><%= cart.items.reduce((sum, item) => sum + item.quantity * item.product.price, 0).toFixed(2) %></span>
            </span>
          </div>

          <a href="/cart/checkout" class="btn-checkout-main">
            Proceed to Checkout
            <i class="fa-solid fa-arrow-right"></i>
          </a>

          <div class="summary-trust">
            <span><i class="fa-solid fa-lock"></i> Secure checkout</span>
            <span><i class="fa-solid fa-truck-fast"></i> COD available</span>
          </div>

        </div>
      </div>

    </div>

  <% } else { %>

    <div class="cart-empty-state">
      <div class="cart-empty-icon">
        <i class="fa-solid fa-bag-shopping"></i>
      </div>
      <h3>Your cart is empty</h3>
      <p>Looks like you haven't added anything yet.</p>
      <a href="/products" class="btn-lumeo-primary">
        <i class="fa-solid fa-arrow-left"></i>
        Browse Products
      </a>
    </div>

  <% } %>

</div>