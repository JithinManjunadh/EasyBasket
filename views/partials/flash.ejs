<% if (success && success.length > 0) { %>
<div class="flash flash-success" role="alert">
  <div class="flash-left">
    <i class="fa-solid fa-circle-check flash-icon"></i>
    <span class="flash-text"><%= success %></span>
  </div>
  <button class="flash-close" onclick="this.parentElement.remove()" aria-label="Close">
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>
<% } %>

<% if (error && error.length > 0) { %>
<div class="flash flash-error" role="alert">
  <div class="flash-left">
    <i class="fa-solid fa-circle-exclamation flash-icon"></i>
    <span class="flash-text"><%= error %></span>
  </div>
  <button class="flash-close" onclick="this.parentElement.remove()" aria-label="Close">
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>
<% } %>
