<% layout("/layouts/boilerplate") %>

<div class="auth-page">

  <div class="auth-card">

    <!-- Left: Brand Panel -->
    <div class="auth-brand-panel">
      <div class="auth-brand-panel-inner">
        <a href="/products" class="auth-panel-logo">EasyBasket</a>
        <h2 class="auth-panel-headline">
          Join EasyBasket.<br>Shop the finest.
        </h2>
        <p class="auth-panel-body">
          Create your free account and unlock exclusive member
          benefits, order tracking, and a seamless shopping experience.
        </p>
        <div class="auth-panel-features">
          <div class="auth-panel-feature">
            <i class="fa-solid fa-bolt"></i>
            <span>Instant account setup</span>
          </div>
          <div class="auth-panel-feature">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>Full order history</span>
          </div>
          <div class="auth-panel-feature">
            <i class="fa-solid fa-tag"></i>
            <span>Member-only deals</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Signup Form -->
    <div class="auth-form-panel">
      <div class="auth-form-inner">

        <div class="auth-form-header">
          <h1 class="auth-form-title">Create account</h1>
          <p class="auth-form-subtitle">Join EasyBasket — it's free</p>
        </div>

        <form action="/signup" method="POST" class="needs-validation auth-form" novalidate>

          <div class="auth-field">
            <label for="username" class="form-label">Username</label>
            <input
              name="username"
              id="username"
              type="text"
              class="form-control"
              placeholder="choose_a_username"
              required
            >
            <div class="valid-feedback">Looks good!</div>
          </div>

          <div class="auth-field">
            <label for="email" class="form-label">Email Address</label>
            <input
              name="email"
              id="email"
              type="email"
              class="form-control"
              placeholder="you@example.com"
              required
            >
          </div>

          <div class="auth-field">
            <label for="password" class="form-label">Password</label>
            <div class="password-field-wrap">
              <input
                name="password"
                id="password"
                type="password"
                class="form-control"
                placeholder="Create a strong password"
                required
              >
              <button
                type="button"
                class="password-toggle"
                onclick="togglePassword('password', this)"
                tabindex="-1"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-lumeo-primary auth-submit-btn">
            Create Account
            <i class="fa-solid fa-arrow-right"></i>
          </button>

        </form>

        <div class="auth-footer-text">
          Already have an account?
          <a href="/login" class="auth-link">Sign in →</a>
        </div>

      </div>
    </div>

  </div>

</div>

<script>
function togglePassword(fieldId, btn) {
  const field = document.getElementById(fieldId);
  const icon = btn.querySelector('i');
  if (field.type === 'password') {
    field.type = 'text';
    icon.classList.replace('fa-eye', 'fa-eye-slash');
  } else {
    field.type = 'password';
    icon.classList.replace('fa-eye-slash', 'fa-eye');
  }
}
</script>