<% layout("/layouts/boilerplate") %>

<div class="auth-page">

  <div class="auth-card">

    <!-- Left: Brand Panel -->
    <div class="auth-brand-panel">
      <div class="auth-brand-panel-inner">
        <a href="/products" class="auth-panel-logo">EasyBasket</a>
        <h2 class="auth-panel-headline">
          Shop smarter.<br>Live better.
        </h2>
        <p class="auth-panel-body">
          Discover premium products curated just for you.
          Sign in to access your cart, orders, and exclusive deals.
        </p>
        <div class="auth-panel-features">
          <div class="auth-panel-feature">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Free delivery on all orders</span>
          </div>
          <div class="auth-panel-feature">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Easy 7-day returns</span>
          </div>
          <div class="auth-panel-feature">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Secure, encrypted checkout</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Login Form -->
    <div class="auth-form-panel">
      <div class="auth-form-inner">

        <div class="auth-form-header">
          <h1 class="auth-form-title">Welcome back</h1>
          <p class="auth-form-subtitle">Sign in to your EasyBasket account</p>
        </div>

        <form action="/login" method="POST" class="needs-validation auth-form" novalidate>

          <div class="auth-field">
            <label for="username" class="form-label">Username</label>
            <input
              name="username"
              id="username"
              type="text"
              class="form-control"
              placeholder="your_username"
              required
            >
          </div>

          <div class="auth-field">
            <label for="password" class="form-label">Password</label>
            <div class="password-field-wrap">
              <input
                name="password"
                id="password"
                type="password"
                class="form-control"
                placeholder="••••••••"
                required
              >
              <button
                type="button"
                class="password-toggle"
                onclick="togglePassword('password', this)"
                tabindex="-1"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-lumeo-primary auth-submit-btn">
            Sign In
            <i class="fa-solid fa-arrow-right"></i>
          </button>

        </form>

        <div class="auth-footer-text">
          Don't have an account?
          <a href="/signup" class="auth-link">Create one →</a>
        </div>

      </div>
    </div>

  </div>

</div>

<script>
function togglePassword(fieldId, btn) {
  const field = document.getElementById(fieldId);
  const icon = btn.querySelector('i');
  if (field.type === 'password') {
    field.type = 'text';
    icon.classList.replace('fa-eye', 'fa-eye-slash');
  } else {
    field.type = 'password';
    icon.classList.replace('fa-eye-slash', 'fa-eye');
  }
}
</script>