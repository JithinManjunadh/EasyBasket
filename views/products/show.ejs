<%- layout("layouts/boilerplate") %>

<div class="product-show-page">

  <!-- Breadcrumb -->
  <nav class="product-breadcrumb" aria-label="breadcrumb">
    <a href="/products" class="breadcrumb-link">
      <i class="fa-solid fa-arrow-left"></i> All Products
    </a>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-current"><%= product.title %></span>
  </nav>

  <div class="row g-5 align-items-start">

    <!-- Product Image -->
    <div class="col-md-6">
      <div class="product-image-wrapper">
        <img
          src="<%= product.image.url %>"
          alt="<%= product.title %>"
          class="product-view-img"
          loading="lazy"
        >
        <span class="product-show-badge"><%= product.category %></span>
      </div>
    </div>

    <!-- Product Details -->
    <div class="col-md-6">
      <div class="product-detail-panel">

        <div class="product-detail-header">
          <h1 class="product-detail-title"><%= product.title %></h1>
          <div class="product-detail-price">$<%= product.price %></div>
        </div>

        <div class="product-detail-meta">
          <span class="meta-label">Category</span>
          <span class="meta-value"><%= product.category %></span>
        </div>

        <div class="product-detail-divider"></div>

        <p class="product-detail-description"><%= product.description %></p>

        <div class="product-detail-divider"></div>

        <!-- Add to Cart -->
        <div class="product-detail-actions">
          <button
            class="btn add-to-cart-btn add-to-cart-lg <%= cartQuantities ? 'in-basket' : '' %>"
            data-product-id="<%= product._id %>"
          >
            <% if (cartQuantities) { %>
              <i class="fa-solid fa-check"></i> In Basket
            <% } else { %>
              <i class="fa-solid fa-bag-shopping"></i> Add to Cart
            <% } %>
          </button>

          <span class="product-quantity" id="quantity-<%= product._id %>">
            <%= cartQuantities ? cartQuantities[product._id] : '' %>
          </span>
        </div>

        <a href="/cart" class="go-to-cart-btn">
          <i class="fa-solid fa-bag-shopping"></i>
          View Cart
        </a>

        <!-- Trust Badges -->
        <div class="trust-badges">
          <div class="trust-badge">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Secure Checkout</span>
          </div>
          <div class="trust-badge">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Fast Delivery</span>
          </div>
          <div class="trust-badge">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Easy Returns</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>