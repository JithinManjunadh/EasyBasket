<%- layout("layouts/boilerplate") %>

<% if(category === 'All') { %>
<div class="carousel-container">
  <div class="carousel-slide">
    <img src="/images/flight.jpg" alt="Mega Deals">
    <div class="carousel-text-box">
      <h2>Roundtrip booking offers!</h2>
      <h3>Up to ₹3,500 Off</h3>
      <p>Book now</p>
      <div class="promo-code">USE CODE: ROUNDTRIP</div>
    </div>
  </div>

  <div class="carousel-slide">
    <img src="/images/buds.jpg" alt="Limited Time Offers">
    <div class="carousel-text-box"></div>
  </div>

  <div class="carousel-slide">
    <img src="/images/sale.jpg" alt="Flash Sale">
    <div class="carousel-text-box">
      <h2>Flash Sale!</h2>
      <h3>Save Big Today!</h3>
      <p>Shop now</p>
      <div class="promo-code">CODE: FLASH20</div>
    </div>
  </div>

  <div class="carousel-slide">
    <img src="/images/card.jpg" alt="Exclusive for Members">
    <div class="carousel-text-box">
      <h2>Exclusive for Members</h2>
      <h3>Get 15% Off Your Next Purchase</h3>
      <p>Join now</p>
    </div>
  </div>

  <div class="carousel-slide">
    <img src="/images/mobiles.jpg" alt="New Arrivals">
    <div class="carousel-text-box">
      <h2>Fresh Stock Just In!</h2>
      <h3>Discover the Latest Trends</h3>
      <p>Explore</p>
    </div>
  </div>

  <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
  <a class="next" onclick="plusSlides(1)">&#10095;</a>

  <div class="dots-container">
    <span class="dot active" onclick="currentSlide(1)"></span>
    <span class="dot" onclick="currentSlide(2)"></span>
    <span class="dot" onclick="currentSlide(3)"></span>
    <span class="dot" onclick="currentSlide(4)"></span>
    <span class="dot" onclick="currentSlide(5)"></span>
  </div>
</div>
<% } %>

<div class="top-bar">
  <div class="category-menu">
    <% const categories = ['All','Electronics','Books','Clothing','Furniture','Toys']; %>
    <% categories.forEach(cat => { %>
      <a href="/products?category=<%= cat %>" class="menu-item <%= category === cat ? 'active' : '' %>">
        <%= cat %>
      </a>
    <% }) %>
  </div>
</div>

<% if (products.length === 0) { %>
  <div class="empty-products">
    <div class="empty-products-icon"><i class="fa-solid fa-box-open"></i></div>
    <h3>No products found</h3>
    <p>Try a different category or check back later.</p>
    <a href="/products" class="btn-lumeo-primary">Browse All Products</a>
  </div>
<% } else { %>
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-2 row-cols-2 g-4">
    <% products.forEach(p => { %>
      <div class="col">
        <div class="card listing-card">
          <div class="card-img-wrapper">
            <img src="<%= p.image.url %>" class="card-img-top show-img" alt="<%= p.title %>" loading="lazy">
            <span class="card-category-badge"><%= p.category %></span>
          </div>
          <div class="card-body">
            <h5 class="card-title"><%= p.title %></h5>
            <p class="card-text">$<%= p.price %></p>
            <div class="product-btns">
              <a href="/products/<%= p._id %>" class="btn btn-primary">View</a>
              <button class="btn add-to-cart-btn <%= cartQuantities[p._id] ? 'in-basket' : '' %>" data-product-id="<%= p._id %>">
                <%= cartQuantities[p._id] ? 'In Basket' : 'Add to Cart' %>
              </button>
              <span class="product-quantity" id="quantity-<%= p._id %>">
                <%= cartQuantities[p._id] || '' %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<script src="/js/carousel.js"></script>
